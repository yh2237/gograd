#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Y { float y[]; };
layout(set = 0, binding = 3, std430) readonly buffer R { float residual[]; };
layout(push_constant) uniform Params { uint n; uint op; float scalar; uint channels; float scalar2; } p;

float fmaxGo(float x, float w) {
    if (isnan(x) || isnan(w)) return uintBitsToFloat(0x7fc00000u);
    if (x == 0.0 && w == 0.0) return uintBitsToFloat(floatBitsToUint(x) & floatBitsToUint(w));
    return max(x, w);
}

float fminGo(float x, float w) {
    if (isnan(x) || isnan(w)) return uintBitsToFloat(0x7fc00000u);
    if (x == 0.0 && w == 0.0) return uintBitsToFloat(floatBitsToUint(x) | floatBitsToUint(w));
    return min(x, w);
}

float log1pPos(float u) {
    float s = 1.0 + u;
    if (s == 1.0) return u;
    return log(s) * (u / (s - 1.0));
}

float erfApprox(float v) {
    if (isnan(v)) return v;
    float av = abs(v);
    if (av > 6.0) return v < 0.0 ? -1.0 : 1.0;
    float t = 1.0 / (1.0 + 0.3275911 * av);
    float e = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-av * av);
    return v < 0.0 ? -e : e;
}

bool isOddInt(float e) {
    float fe = floor(e);
    return fe == e && abs(fe) < 16777216.0 && (int(fe) & 1) != 0;
}

float powScalar(float x, float e) {
    if (e == 0.0 || x == 1.0) return 1.0;
    if (isnan(x) || isnan(e)) return uintBitsToFloat(0x7fc00000u);
    bool neg = (floatBitsToUint(x) & 0x80000000u) != 0u;
    if (x == 0.0) {
        float r = e > 0.0 ? 0.0 : uintBitsToFloat(0x7f800000u);
        return (neg && isOddInt(e)) ? -r : r;
    }
    if (isinf(e)) {
        float ax = abs(x);
        if (ax == 1.0) return 1.0;
        if ((ax > 1.0) == (e > 0.0)) return uintBitsToFloat(0x7f800000u);
        return 0.0;
    }
    if (isinf(x)) {
        float r = e > 0.0 ? uintBitsToFloat(0x7f800000u) : 0.0;
        return (neg && isOddInt(e)) ? -r : r;
    }
    if (x > 0.0) return pow(x, e);
    if (floor(e) == e) {
        float r = pow(-x, e);
        return isOddInt(e) ? -r : r;
    }
    return uintBitsToFloat(0x7fc00000u);
}

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 128u;
    if (i >= p.n) return;
    uint op = p.op;
    if (op == 0u) y[i] = a[i] + b[i];
    else if (op == 1u) y[i] = a[i] * b[i];
    else if (op == 2u) y[i] = a[i] * p.scalar;
    else if (op == 6u) {
        precise float sum = a[i] + b[i % p.channels];
        y[i] = sum + residual[i];
    }
    else if (op == 3u || op == 4u || op == 5u) {
        float v = a[i];
        if (op == 5u) v = v + b[i % p.channels];
        if (v > 10.0) { y[i] = v; return; }
        if (v < -10.0) { y[i] = 0.0; return; }
        if (op == 3u) y[i] = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v)));
        else y[i] = 0.5 * v * (1.0 + erfApprox(v * 0.7071067812));
    }
    else if (op == 7u) y[i] = a[i] - b[i];
    else if (op == 8u) y[i] = a[i] / b[i];
    else if (op == 9u) y[i] = fmaxGo(a[i], b[i]);
    else if (op == 10u) y[i] = fminGo(a[i], b[i]);
    else if (op == 11u) y[i] = a[i] + p.scalar;
    else if (op == 12u) y[i] = a[i] - p.scalar;
    else if (op == 13u) y[i] = a[i] / p.scalar;
    else if (op == 14u) y[i] = powScalar(a[i], p.scalar);
    else if (op == 15u) y[i] = exp(a[i]);
    else if (op == 16u) {
        float v = a[i];
        if (isnan(v) || v < 0.0) y[i] = uintBitsToFloat(0x7fc00000u);
        else if (v == 0.0) y[i] = uintBitsToFloat(0xff800000u);
        else if (isinf(v)) y[i] = uintBitsToFloat(0x7f800000u);
        else y[i] = log(v);
    }
    else if (op == 17u) y[i] = abs(a[i]);
    else if (op == 18u) {
        float v = a[i];
        if (isnan(v)) y[i] = v;
        else if (v > 20.0) y[i] = 1.0;
        else if (v < -20.0) y[i] = -1.0;
        else y[i] = tanh(v);
    }
    else if (op == 19u) {
        float v = a[i];
        y[i] = v > 0.0 ? v : 0.0;
    }
    else if (op == 20u) y[i] = sin(a[i]);
    else if (op == 21u) y[i] = cos(a[i]);
    else if (op == 22u) {
        float v = a[i];
        if (isnan(v) || v < 0.0) y[i] = uintBitsToFloat(0x7fc00000u);
        else y[i] = sqrt(v);
    }
    else if (op == 23u) {
        float v = a[i];
        if (isnan(v)) y[i] = v;
        else if (v >= 0.0) y[i] = 1.0 / (1.0 + exp(-v));
        else { float e = exp(v); y[i] = e / (1.0 + e); }
    }
    else if (op == 24u) {
        float v = a[i];
        if (isnan(v)) y[i] = v;
        else if (v > 20.0) y[i] = v;
        else if (v < -88.0) y[i] = 0.0;
        else y[i] = max(v, 0.0) + log1pPos(exp(-abs(v)));
    }
    else if (op == 25u) y[i] = erfApprox(a[i]);
    else if (op == 26u) y[i] = fminGo(fmaxGo(a[i], p.scalar), p.scalar2);
    else if (op == 27u) y[i] = p.scalar;
}
