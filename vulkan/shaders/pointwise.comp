#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params { uint n; uint op; float scalar; } p;

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 128u;
    if (i >= p.n) return;
    if (p.op == 0u) y[i] = a[i] + b[i];
    else if (p.op == 1u) y[i] = a[i] * b[i];
    else if (p.op == 2u) y[i] = a[i] * p.scalar;
    else {
        float v = a[i];
        if (v > 10.0) { y[i] = v; return; }
        if (v < -10.0) { y[i] = 0.0; return; }
        if (p.op == 3u) y[i] = 0.5*v*(1.0+tanh(0.7978845608*(v+0.044715*v*v*v)));
        else {
            // Abramowitz-Stegun 7.1.26, erf absolute error < 1.5e-7.
            float z = abs(v)*0.7071067812;
            float t = 1.0/(1.0+0.3275911*z);
            float e = 1.0-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*exp(-z*z);
            y[i] = 0.5*v*(1.0+(v < 0.0 ? -e : e));
        }
    }
}
