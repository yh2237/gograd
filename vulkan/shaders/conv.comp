#version 450
layout(local_size_x = 128) in;
layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params {
    uint n; uint inputLength; uint inChannels; uint kernel; uint outputLength;
    uint stride; uint padding; uint dilation; uint kind; uint outChannels;
} p;
void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y*gl_NumWorkGroups.x*128u;
    if (i >= p.n) return;
    if (p.kind == 1u) { y[i] = x[i]+b[i%p.outChannels]; return; }
    uint kernel = i%p.kernel, ch = (i/p.kernel)%p.inChannels;
    uint row = i/(p.kernel*p.inChannels), time = row%p.outputLength, batch = row/p.outputLength;
    // OutputLength validation bounds both terms; use unsigned coordinates to
    // avoid signed overflow for very large padding/dilation combinations.
    uint source = time*p.stride + kernel*p.dilation;
    y[i] = source >= p.padding && source-p.padding < p.inputLength
        ? x[(batch*p.inputLength+source-p.padding)*p.inChannels+ch] : 0.0;
}
