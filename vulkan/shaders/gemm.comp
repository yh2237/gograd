#version 450
// 128 invocations and 8320 bytes of shared memory fit Vulkan 1.1's minimum
// limits. Each workgroup computes a 64x64 (SMALL_M=0) or 32x64 (SMALL_M=1) tile.
layout(local_size_x = 16, local_size_y = 8) in;
layout(constant_id = 0) const uint TRANS_A = 0u;
layout(constant_id = 1) const uint TRANS_B = 0u;
layout(constant_id = 2) const uint SMALL_M = 0u;
layout(set = 0, binding = 0, std430) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer C { float c[]; };
layout(push_constant) uniform Params {
    uint m; uint n; uint k; uint batch;
    uint aOffset; uint bOffset;
    uint aRow; uint aCol; uint bRow; uint bCol;
    uint batchRank;
    uint batchShape[4]; uint aBatchStrides[4]; uint bBatchStrides[4];
    uint tileCols; uint tilesPerMatrix;
} p;
shared float tileA[16][65];
shared float tileB[16][65];

uint indexA(uint row, uint depth) {
    return TRANS_A != 0u ? row*p.aCol + depth*p.aRow : row*p.aRow + depth*p.aCol;
}
uint indexB(uint depth, uint col) {
    return TRANS_B != 0u ? depth*p.bCol + col*p.bRow : depth*p.bRow + col*p.bCol;
}

void main() {
    uint tile = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint batch = tile / p.tilesPerMatrix;
    if (batch >= p.batch) return;
    uint matrixTile = tile % p.tilesPerMatrix;
    uint tileM = (matrixTile / p.tileCols) * (SMALL_M != 0u ? 32u : 64u);
    uint tileN = (matrixTile % p.tileCols) * 64u;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    uint tid = ly * 16u + lx;

    uint rest = batch, ao = p.aOffset, bo = p.bOffset;
    for (int axis = int(p.batchRank)-1; axis >= 0; --axis) {
        uint coord = rest % p.batchShape[axis];
        rest /= p.batchShape[axis];
        ao += coord*p.aBatchStrides[axis];
        bo += coord*p.bBatchStrides[axis];
    }

    const uint ROWS = SMALL_M != 0u ? 4u : 8u;
    float acc[8][4];
    for (uint r = 0u; r < ROWS; ++r) {
        for (uint cc = 0u; cc < 4u; ++cc) {
            acc[r][cc] = 0.0;
        }
    }

    for (uint base = 0u; base < p.k; base += 16u) {
        if (TRANS_A == 0u) {
            uint kLocal = tid & 15u;
            uint mBase = tid >> 4u;
            uint da = base + kLocal;
            for (uint s = 0u; s < ROWS; ++s) {
                uint mLocal = mBase + s * 8u;
                uint row = tileM + mLocal;
                tileA[kLocal][mLocal] = (row < p.m && da < p.k) ? a[ao + indexA(row, da)] : 0.0;
            }
        } else if (SMALL_M != 0u) {
            uint mLocal = tid & 31u;
            uint kBase = tid >> 5u;
            uint row = tileM + mLocal;
            for (uint s = 0u; s < 4u; ++s) {
                uint kLocal = kBase + s * 4u;
                uint da = base + kLocal;
                tileA[kLocal][mLocal] = (row < p.m && da < p.k) ? a[ao + indexA(row, da)] : 0.0;
            }
        } else {
            uint mLocal = tid & 63u;
            uint kBase = tid >> 6u;
            uint row = tileM + mLocal;
            for (uint s = 0u; s < 8u; ++s) {
                uint kLocal = kBase + s * 2u;
                uint da = base + kLocal;
                tileA[kLocal][mLocal] = (row < p.m && da < p.k) ? a[ao + indexA(row, da)] : 0.0;
            }
        }

        if (TRANS_B == 0u) {
            uint nLocal = tid & 63u;
            uint kBase = tid >> 6u;
            uint col = tileN + nLocal;
            for (uint s = 0u; s < 8u; ++s) {
                uint kLocal = kBase + s * 2u;
                uint db = base + kLocal;
                tileB[kLocal][nLocal] = (db < p.k && col < p.n) ? b[bo + indexB(db, col)] : 0.0;
            }
        } else {
            uint kLocal = tid & 15u;
            uint nBase = tid >> 4u;
            uint db = base + kLocal;
            for (uint s = 0u; s < 8u; ++s) {
                uint nLocal = nBase + s * 8u;
                uint col = tileN + nLocal;
                tileB[kLocal][nLocal] = (db < p.k && col < p.n) ? b[bo + indexB(db, col)] : 0.0;
            }
        }

        barrier();

        for (uint d = 0u; d < 16u; ++d) {
            float aReg[8];
            for (uint r = 0u; r < ROWS; ++r) {
                aReg[r] = tileA[d][ly + r * 8u];
            }
            float bReg[4];
            for (uint cc = 0u; cc < 4u; ++cc) {
                bReg[cc] = tileB[d][lx + cc * 16u];
            }
            for (uint r = 0u; r < ROWS; ++r) {
                for (uint cc = 0u; cc < 4u; ++cc) {
                    acc[r][cc] = fma(aReg[r], bReg[cc], acc[r][cc]);
                }
            }
        }

        barrier();
    }

    uint batchBase = batch * p.m;
    for (uint r = 0u; r < ROWS; ++r) {
        uint row = tileM + ly + r * 8u;
        if (row >= p.m) continue;
        uint rowBase = (batchBase + row) * p.n;
        for (uint cc = 0u; cc < 4u; ++cc) {
            uint col = tileN + lx + cc * 16u;
            if (col < p.n) {
                c[rowBase + col] = acc[r][cc];
            }
        }
    }
}
