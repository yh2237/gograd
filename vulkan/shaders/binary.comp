#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Params {
    uint n; uint rank; uint op; uint offsetA; uint offsetB;
    uint shape[6];
    uint stridesA[6];
    uint stridesB[6];
} p;

float fmaxGo(float x, float w) {
    if (isnan(x) || isnan(w)) return uintBitsToFloat(0x7fc00000u);
    if (x == 0.0 && w == 0.0) return uintBitsToFloat(floatBitsToUint(x) & floatBitsToUint(w));
    return max(x, w);
}

float fminGo(float x, float w) {
    if (isnan(x) || isnan(w)) return uintBitsToFloat(0x7fc00000u);
    if (x == 0.0 && w == 0.0) return uintBitsToFloat(floatBitsToUint(x) | floatBitsToUint(w));
    return min(x, w);
}

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 128u;
    if (i >= p.n) return;
    uint rest = i;
    uint ia = p.offsetA;
    uint ib = p.offsetB;
    for (uint k = 0u; k < p.rank; k++) {
        uint dim = p.rank - 1u - k;
        uint coord = rest % p.shape[dim];
        rest /= p.shape[dim];
        ia += coord * p.stridesA[dim];
        ib += coord * p.stridesB[dim];
    }
    float x = a[ia], w = b[ib];
    if (p.op == 0u) y[i] = x + w;
    else if (p.op == 1u) y[i] = x * w;
    else if (p.op == 2u) y[i] = x - w;
    else if (p.op == 3u) y[i] = x / w;
    else if (p.op == 4u) y[i] = fmaxGo(x, w);
    else y[i] = fminGo(x, w);
}
