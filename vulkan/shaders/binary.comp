#version 450
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer A { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer B { float b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Y { float y[]; };
// Both operands share the broadcast shape; their strides and offsets differ, so
// the source index of every element is computed from the output coordinates.
layout(push_constant) uniform Params {
    uint n; uint rank; uint op; uint offsetA; uint offsetB;
    uint shape[6];
    uint stridesA[6];
    uint stridesB[6];
} p;

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 128u;
    if (i >= p.n) return;
    uint rest = i;
    uint ia = p.offsetA;
    uint ib = p.offsetB;
    for (uint k = 0u; k < p.rank; k++) {
        uint dim = p.rank - 1u - k;
        uint coord = rest % p.shape[dim];
        rest /= p.shape[dim];
        ia += coord * p.stridesA[dim];
        ib += coord * p.stridesB[dim];
    }
    if (p.op == 0u) y[i] = a[ia] + b[ib];
    else y[i] = a[ia] * b[ib];
}
